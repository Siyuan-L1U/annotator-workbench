[Unit]
Description=Annotation Intern Progress
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/annotation-intern-progress
Environment=HOST=127.0.0.1
Environment=PORT=8766
Environment=BASE_PATH=/progress
ExecStart=/usr/bin/python3 /opt/annotation-intern-progress/server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
